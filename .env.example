# Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Backend URL (change in production)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Free hot-lead push notification via Telegram (optional — the app runs
# fine without these, it just skips sending the alert and logs a warning).
# Setup: message @BotFather on Telegram to create a bot and get a token,
# then message your new bot once and get your chat ID from @userinfobot
# or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Free Redis (Upstash: https://upstash.com — no credit card required) used
# for persistent session storage, response caching, and rate limiting.
# Use the standard "redis://" or "rediss://" connection string, not the
# REST API URL.
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Required to call GET /api/admin/analytics. Pick any long random string.
ADMIN_API_KEY=change_me_to_a_random_secret
