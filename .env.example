# ── Backend (backend/.env) ───────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated frontend origins allowed by CORS (localhost is always allowed)
ALLOWED_ORIGINS=https://travel-voice-concierge.vercel.app
# Session storage on Turso (optional locally; required on Vercel)
ARIA_TURSO_URL=https://aria-<org>.<region>.turso.io
ARIA_TURSO_TOKEN=your_turso_db_token
# Optional: hot-lead and handoff alerts via Telegram (@BotFather for a token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: enables GET /api/admin/analytics (send as X-Admin-Key)
ADMIN_API_KEY=
# Optional model overrides
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# LIVE_VOICE=Aoede

# ── Frontend (frontend/.env.local) ───────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Set to false to skip Gemini Live and use Lite voice mode
NEXT_PUBLIC_ENABLE_LIVE=true
